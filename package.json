{
  "name": "opendocflow",
  "version": "3.2.0",
  "description": "OpenDocFlow v3.2 - Complete AI Agent Gateway, MCP Manager, Agents/Commands Studio, Profiles, Bulk Skill/Plugin Editor & Key Scanner",
  "author": "vaasiraq-art",
  "license": "SEE LICENSE IN LICENSE",
  "repository": {
    "type": "git",
    "url": "https://github.com/vaasiraq-art/OpenDocFlow.git"
  },
  "bugs": {
    "url": "https://github.com/vaasiraq-art/OpenDocFlow/issues"
  },
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "dist": "electron-builder --win nsis"
  },
  "dependencies": {
    "jsonc-parser": "^3.3.1"
  },
  "devDependencies": {
    "electron": "^45.0.0",
    "electron-builder": "^26.18.0"
  },
  "build": {
    "appId": "com.opendocflow.desktop",
    "productName": "OpenDocFlow",
    "asar": true,
    "compression": "store",
    "protocols": [
      {
        "name": "OpenDocFlow Deep Link",
        "schemes": [
          "opendocflow"
        ]
      }
    ],
    "directories": {
      "output": "dist"
    },
    "files": [
      "main.js",
      "preload.js",
      "app/**/*",
      "assets/**/*",
      "package.json"
    ],
    "extraResources": [
      {
        "from": "setup-kit",
        "to": "setup-kit",
        "filter": [
          "**/*"
        ]
      }
    ],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "build/icon.ico"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowElevation": true,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": "always",
      "createStartMenuShortcut": true,
      "shortcutName": "OpenDocFlow",
      "license": "build/PREREQUISITES.txt",
      "runAfterFinish": true
    }
  }
}
