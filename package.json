{
  "name": "opencode-studio",
  "version": "2.0.0",
  "description": "OpenCode Studio v2.0 - Blender-UI AI Gateway, Auto-Fallback Router, Skills/Plugins Hub & Auto Bug Reporter",
  "author": "vaasiraq-art",
  "license": "SEE LICENSE IN LICENSE",
  "repository": {
    "type": "git",
    "url": "https://github.com/vaasiraq-art/opencode-studio.git"
  },
  "bugs": {
    "url": "https://github.com/vaasiraq-art/opencode-studio/issues"
  },
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "dist": "electron-builder --win nsis"
  },
  "dependencies": {
    "jsonc-parser": "^3.3.1"
  },
  "devDependencies": {
    "electron": "^45.0.0",
    "electron-builder": "^26.18.0"
  },
  "build": {
    "appId": "com.opencodestudio.desktop",
    "productName": "OpenCode Studio",
    "asar": true,
    "directories": {
      "output": "dist"
    },
    "files": [
      "main.js",
      "preload.js",
      "app/**/*",
      "assets/**/*",
      "package.json"
    ],
    "extraResources": [
      {
        "from": "setup-kit",
        "to": "setup-kit",
        "filter": [
          "**/*"
        ]
      }
    ],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "build/icon.ico"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowElevation": true,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": "always",
      "createStartMenuShortcut": true,
      "shortcutName": "OpenCode Studio",
      "license": "build/PREREQUISITES.txt",
      "runAfterFinish": true
    }
  }
}
