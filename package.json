{
  "name": "opendocflow",
  "version": "4.0.1",
  "description": "OpenDocFlow v4.0.1 — Autonomous AI Agent Studio, Multi-Agent Hub (@opendocflow + OpenCode V2 + Claude + Codex + Gemini + Qwen + Aider), DocFlow Repo Packager & AI Docs, 1-Click MCP Marketplace & True-SSE Smart Gateway",
  "author": "vaasiraq-art",
  "license": "SEE LICENSE IN LICENSE",
  "repository": {
    "type": "git",
    "url": "https://github.com/vaasiraq-art/OpenDocFlow.git"
  },
  "bugs": {
    "url": "https://github.com/vaasiraq-art/OpenDocFlow/issues"
  },
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "dist": "electron-builder --win nsis portable"
  },
  "dependencies": {
    "jsonc-parser": "^3.3.1"
  },
  "devDependencies": {
    "electron": "35.7.5",
    "electron-builder": "^26.18.0"
  },
  "build": {
    "appId": "com.opendocflow.desktop",
    "productName": "OpenDocFlow",
    "asar": true,
    "asarUnpack": [
      "mcp/**/*"
    ],
    "compression": "normal",
    "protocols": [
      {
        "name": "OpenDocFlow Deep Link",
        "schemes": [
          "opendocflow"
        ]
      }
    ],
    "directories": {
      "output": "dist"
    },
    "files": [
      "main.js",
      "preload.js",
      "lib/**/*",
      "mcp/**/*",
      "app/**/*",
      "assets/**/*",
      "package.json"
    ],
    "extraResources": [
      {
        "from": "setup-kit",
        "to": "setup-kit",
        "filter": [
          "**/*"
        ]
      }
    ],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "portable",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "build/icon.ico"
    },
    "nsis": {
      "artifactName": "${productName} Setup ${version}.${ext}",
      "oneClick": false,
      "perMachine": false,
      "allowElevation": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": "always",
      "createStartMenuShortcut": true,
      "shortcutName": "OpenDocFlow",
      "license": "build/PREREQUISITES.txt",
      "runAfterFinish": true
    },
    "portable": {
      "artifactName": "${productName}-Portable-${version}.${ext}"
    }
  }
}
